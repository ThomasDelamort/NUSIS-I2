# Postgres connection string. SSL is enabled automatically for neon.tech hosts.
DATABASE_URL=postgres://user:password@localhost:5432/nusis
# PGSSL=true

# AWS S3 for profile pictures (same credentials as the Smart Library System).
# Uploads are stored under the nusis/ folder of the bucket.
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=your_region
AWS_BUCKET_NAME=your_bucket_name

# Origins allowed to call the API from a browser, comma-separated (e.g. the hosted dashboard).
# Leave unset to allow any origin.
# CORS_ORIGIN=https://dashboard.example.com
