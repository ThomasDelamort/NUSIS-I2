erDiagram
    STUDENTS {
        int StudentId PK "PRIMARY KEY"
        varchar(15) RfidUid UK "UNIQUE NOT NULL"
        varchar(50) FirstName "NOT NULL"
        varchar(50) LastName "NOT NULL"
        varchar(20) UniversityId UK "UNIQUE NOT NULL"
        varchar(255) UniversityEmail UK "UNIQUE NOT NULL"
        varchar(20) ContactNumber "NULLABLE"
        varchar(255) ProfilePicture "NULLABLE"
        varchar(20) EmergencyContactNumber "NULLABLE"
        timestamptz CreatedAt "NOT NULL"
    }

    ADMIN {
        int admin_id PK "PRIMARY KEY"
        varchar(15) refid_uid UK "UNIQUE NOT NULL"
        varchar(50) first_name "NOT NULL"
        varchar(50) last_name "NOT NULL"
        varchar(255) university_email UK "UNIQUE NOT NULL"
        varchar(20) phone_number "NULLABLE"
        varchar(255) profile_picture_url "NULLABLE"
        timestamptz created_at "NOT NULL"
    }

    DAILY_LOGS {
        int log_id PK "PRIMARY KEY"
        int student_id FK "NOT NULL, REFERENCES STUDENTS(student_id)"
        timestamptz time_in "NOT NULL"
        timestamptz time_out "NULLABLE"
    }

    ADMIN ||--o{ STUDENTS : "manages"
    STUDENTS ||--o{ DAILY_LOGS : "punches in/out"
